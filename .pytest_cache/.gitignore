.env

# Virtual Environment
venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
test_models.py

# Local runtime data - must not be committed. Config.init_app() creates
# these fresh via os.makedirs(exist_ok=True); a fresh deploy should
# start with empty storage, not local dev/test data.
chroma_db/*
!chroma_db/.gitkeep
uploads/*
!uploads/.gitkeep
generated_docs/*
!generated_docs/.gitkeep
logs/*
!logs/.gitkeep
*.db
*.sqlite3
instance/
